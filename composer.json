{
    "name": "syriable/filament-utilities",
    "description": "Developer tooling for the Syriable Filament ecosystem — translatable resource generators and modular plugin scaffolding.",
    "keywords": [
        "syriable",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-utilities"
    ],
    "homepage": "https://github.com/syriable/filament-utilities",
    "support": {
        "issues": "https://github.com/syriable/filament-utilities/issues",
        "source": "https://github.com/syriable/filament-utilities"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "syriable",
            "email": "info@syriable.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.3.5",
        "spatie/laravel-package-tools": "^1.15.0",
        "syriable/filament-translator": "^1.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Syriable\\Filament\\Plugins\\Utilities\\": "src/",
            "Syriable\\Filament\\Plugins\\Utilities\\Database\\Factories\\": "database/factories/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Syriable\\Filament\\Plugins\\Utilities\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest --no-coverage",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Syriable\\Filament\\Plugins\\Utilities\\UtilitiesServiceProvider"
            ],
            "aliases": {
                "Utilities": "Syriable\\Filament\\Plugins\\Utilities\\Facades\\Utilities"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
